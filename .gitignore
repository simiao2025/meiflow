# ========================================
# MEIFlow .gitignore
# ========================================

# --- Dependências ---
node_modules/
.pnp
.pnp.js

# --- Build / Output ---
dist/
build/
.next/
out/
*.tsbuildinfo

# --- Expo ---
.expo/
web-build/
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
.eggs/
pip-log.txt

# --- Ambiente ---
.env
.env.local
.env.development
.env.production
.env.staging
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Cache ---
.cache/
.parcel-cache/
.eslintcache
.prettiercache
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- Testes ---
coverage/
htmlcov/
.nyc_output/

# --- Relatórios de auditoria ---
reports/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editores ---
.idea/
*.swp
*.swo
*~
.vscode/settings.json
.vscode/launch.json

# --- Docker ---
docker-compose.override.yml

# --- Supabase ---
supabase/.temp/
supabase/.branches/

# --- Secrets (NUNCA commitar) ---
*.pem
*.cert
*.crt
secrets/
