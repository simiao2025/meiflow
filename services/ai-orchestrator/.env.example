# Configurações do Serviço de IA MEIFlow
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your-evolution-api-key

# Meta WhatsApp Business Cloud API (OAuth Embedded Signup)
# Obter em https://developers.facebook.com/apps/ -> seu App -> WhatsApp
META_APP_ID=000000000000000
META_APP_SECRET=abcdef0123456789abcdef0123456789
META_OAUTH_REDIRECT_URI=https://app.meiflow.com.br/api/v1/crm/meta/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=token-aleatorio-para-validar-webhook-meta

# Webhook Security
WEBHOOK_SECRET_TOKEN=gere-um-token-aleatorio-aqui
ASAAS_WEBHOOK_TOKEN=seu-token-asaas-webhook

# Redis
REDIS_URL=redis://redis:6379/0

# Ambiente
ENV=development
DEBUG=True
