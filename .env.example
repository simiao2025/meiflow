# ========================================
# MEIFlow — Variáveis de Ambiente
# ========================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env no repositório.
# ========================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_DB_URL=postgresql://postgres:senha@db.SEU-PROJETO.supabase.co:5432/postgres

# --- OpenAI (Assistente IA) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Anthropic (Fallback IA) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Asaas (Pagamentos) ---
ASAAS_API_KEY=sua-api-key-aqui
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_SECRET=seu-webhook-secret

# --- Evolution Go (WhatsApp) ---
EVOLUTION_GO_URL=http://localhost:8080
EVOLUTION_GO_API_KEY=sua-api-key-aqui

# --- Google Maps ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=sua-api-key-aqui

# --- Open Finance (Pluggy) ---
PLUGGY_CLIENT_ID=seu-client-id
PLUGGY_CLIENT_SECRET=seu-client-secret

# --- NFS-e Gateway (eNotas / Focus NFe) ---
NFSE_GATEWAY_API_KEY=sua-api-key-aqui
NFSE_GATEWAY_URL=https://api.enotas.com.br

# --- Ambiente ---
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
APP_VERSION=0.1.0
