# ========================================
# MEIFlow Mobile — Variáveis de Ambiente
# ========================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env no repositório.
# ========================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# --- API Backend ---
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- AI Service ---
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8001

# --- Chave Interna (segredo para comunicação interna) ---
# Gere uma chave única para seu ambiente
EXPO_PUBLIC_INTERNAL_KEY=meiflow_internal_key_troque_em_producao

# --- Google Maps ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=sua-api-key-aqui

# --- Ambiente ---
NODE_ENV=development
